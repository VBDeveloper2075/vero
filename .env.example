# ──────────────────────────────────────────────────────────────────
#  FRONTEND (Vite) — prefijo VITE_ = visible en el navegador
# ──────────────────────────────────────────────────────────────────

# URL de la API Express (local o deployada)
VITE_BACKEND_URL=http://localhost:3001

# Debe coincidir con SHARED_SECRET del servidor
VITE_SHARED_SECRET=cambiá-este-secreto

# Clave del panel de historial (solo UI; visible en el bundle)
VITE_HISTORIAL_PIN=7519

# ──────────────────────────────────────────────────────────────────
#  SERVIDOR (Neon) — NUNCA con prefijo VITE_
# ──────────────────────────────────────────────────────────────────

# Connection string de Neon (Dashboard → Connection string)
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.aws.neon.tech/neondb?sslmode=require

# Mismo valor que VITE_SHARED_SECRET
SHARED_SECRET=cambiá-este-secreto

# Puerto local de la API (opcional)
PORT=3001

# Orígenes permitidos (csv). Si no se define, el server usa GitHub Pages + localhost.
# CORS_ORIGINS=https://vbdeveloper2075.github.io,http://localhost:5173
